{
  "name": "root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">= 20",
    "npm": "Please use pnpm instead of npm to install dependencies",
    "yarn": "Please use pnpm instead of yarn to install dependencies",
    "pnpm": ">= 10"
  },
  "scripts": {
    "lerna-typecheck": "pnpm run -r typecheck",
    "lerna-build": "pnpm run -r build",
    "lerna-lint": "pnpm run -r lint",
    "lerna-prodapi": "pnpm run -r prodapi",
    "lerna-test": "pnpm run -r test --run --coverage",
    "lerna-playwright": "PROD=true pnpm run -r playwright",
    "build-docs": "pnpm exec typedoc && pnpm run -r --filter @candidstartup/storybook build-docs",
    "preview-docs": "vite preview --outDir temp",
    "prodbuild": "pnpm run lerna-typecheck && pnpm run lerna-build && pnpm run lerna-lint && pnpm run lerna-prodapi && pnpm run lerna-test && pnpm run lerna-playwright",
    "lerna-version": "pnpm exec lerna version --conventional-commits --sync-workspace-lock",
    "lerna-version-dryrun": "pnpm exec lerna version --conventional-commits --sync-workspace-lock --dry-run",
    "lerna-publish": "pnpm -r publish",
    "test": "vitest --run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gordonmleigh/rollup-plugin-sourcemaps": "^0.1.2",
    "@lerna-lite/cli": "^5.4.2",
    "@lerna-lite/version": "^5.4.2",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "10.5.6",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "jsdom-testing-mocks": "^1.16.0",
    "neverthrow": "^8.2.0",
    "path": "^0.12.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.5.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "storybook": "10.5.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-extras": "^4.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
